# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/cambodia_hrms
REDIS_URL=redis://localhost:6379/0

# Security & Sessions
SECRET_KEY=cambodia-enterprise-hrms-production-super-secret-key-987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Localization & Cambodia Defaults
TIMEZONE=Asia/Phnom_Penh
DEFAULT_CURRENCY=KHR
SECONDARY_CURRENCY=USD
DEFAULT_LANGUAGE=km

# Object Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=hrms-documents
S3_SECURE=false

# AI Gateway (Privacy Default: Disabled)
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gemini-2.5-pro
ALLOW_EMPLOYEE_DATA_TO_AI=false
ALLOW_SALARY_DATA_TO_AI=false

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
